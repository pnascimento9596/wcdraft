{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "remoteCache": {
    "enabled": true
  },
  "globalDependencies": [
    ".prettierrc.json",
    "eslint.config.mjs",
    "pnpm-workspace.yaml",
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/etl/output/**",
        "$TURBO_ROOT$/packages/data/src/generated/**",
        "$TURBO_ROOT$/packages/data/src/retained-runtime-data/**"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "public/data/**",
        "public/sw-version.js"
      ],
      "env": [
        "LEADERBOARD_ENABLED",
        "DATABASE_URL",
        "AUTH_COOKIE_SECRET",
        "WCDRAFT_OG_SIGNING_SECRET",
        "WCDRAFT_CSP_REPORT_ONLY",
        "WCDRAFT_LEADERBOARD_SEASON_ID",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_URL",
        "VERCEL_DEPLOYMENT_ID",
        "WCDRAFT_DEPLOY_REVISION",
        "WCDRAFT_SITE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "RESEND_API_KEY",
        "AUTH_EMAIL_FROM",
        "AUTH_BASE_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/etl/output/**",
        "$TURBO_ROOT$/packages/data/src/generated/**",
        "$TURBO_ROOT$/packages/data/src/retained-runtime-data/**"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/etl/output/**",
        "$TURBO_ROOT$/packages/data/src/generated/**",
        "$TURBO_ROOT$/packages/data/src/retained-runtime-data/**"
      ],
      "outputs": [],
      "env": [
        "WCDRAFT_REALISM_HEAVY",
        "WCDRAFT_REALISM_N",
        "WCDRAFT_REALISM_SEED_PREFIX",
        "WCDRAFT_REALISM_GATE",
        "WCDRAFT_LEADERBOARD_BENCH",
        "LEADERBOARD_ENABLED",
        "AUTH_COOKIE_SECRET",
        "WCDRAFT_OG_SIGNING_SECRET",
        "WCDRAFT_CSP_REPORT_ONLY",
        "WCDRAFT_LEADERBOARD_SEASON_ID",
        "DATABASE_URL",
        "RESEND_API_KEY",
        "AUTH_EMAIL_FROM",
        "AUTH_BASE_URL",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_URL",
        "VERCEL_DEPLOYMENT_ID",
        "WCDRAFT_DEPLOY_REVISION",
        "WCDRAFT_SITE_URL",
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "test:realism:heavy": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/etl/output/**",
        "$TURBO_ROOT$/packages/data/src/generated/**",
        "$TURBO_ROOT$/packages/data/src/retained-runtime-data/**"
      ],
      "outputs": [],
      "env": [
        "WCDRAFT_REALISM_HEAVY",
        "WCDRAFT_REALISM_N",
        "WCDRAFT_REALISM_SEED_PREFIX",
        "WCDRAFT_REALISM_GATE"
      ]
    },
    "test:golden": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/etl/output/**",
        "$TURBO_ROOT$/packages/data/src/generated/**",
        "$TURBO_ROOT$/packages/data/src/retained-runtime-data/**"
      ],
      "outputs": []
    },
    "test:golden:draft": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/etl/output/**",
        "$TURBO_ROOT$/packages/data/src/generated/**",
        "$TURBO_ROOT$/packages/data/src/retained-runtime-data/**"
      ],
      "outputs": []
    },
    "test:golden:data": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/etl/output/**",
        "$TURBO_ROOT$/packages/data/src/generated/**",
        "$TURBO_ROOT$/packages/data/src/retained-runtime-data/**"
      ],
      "outputs": []
    },
    "test:golden:integration": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/etl/output/**",
        "$TURBO_ROOT$/packages/data/src/generated/**",
        "$TURBO_ROOT$/packages/data/src/retained-runtime-data/**"
      ],
      "outputs": []
    },
    "test:golden:leaderboard": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/etl/output/**",
        "$TURBO_ROOT$/packages/data/src/generated/**",
        "$TURBO_ROOT$/packages/data/src/retained-runtime-data/**"
      ],
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL_UNPOOLED", "DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL_UNPOOLED"]
    },
    "db:migrate:status": {
      "cache": false,
      "env": ["DATABASE_URL_UNPOOLED"]
    },
    "db:rollback-check": {
      "cache": false,
      "env": [
        "DATABASE_URL_UNPOOLED",
        "NEON_API_KEY",
        "NEON_PROJECT_ID",
        "NEON_EPHEMERAL_BRANCH_ID"
      ]
    },
    "db:branch:create": {
      "cache": false,
      "env": ["NEON_API_KEY", "NEON_PROJECT_ID", "GITHUB_RUN_ID", "GITHUB_OUTPUT"]
    },
    "db:branch:delete": {
      "cache": false,
      "env": ["NEON_API_KEY", "NEON_PROJECT_ID", "NEON_EPHEMERAL_BRANCH_ID"]
    }
  }
}
