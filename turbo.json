{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "LEADERBOARD_ENABLED",
        "DATABASE_URL",
        "AUTH_COOKIE_SECRET",
        "WCDRAFT_OG_SIGNING_SECRET",
        "WCDRAFT_CSP_REPORT_ONLY",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_URL",
        "VERCEL_DEPLOYMENT_ID",
        "WCDRAFT_DEPLOY_REVISION",
        "WCDRAFT_SITE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "RESEND_API_KEY",
        "AUTH_EMAIL_FROM",
        "AUTH_BASE_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "WCDRAFT_REALISM_HEAVY",
        "WCDRAFT_REALISM_N",
        "WCDRAFT_REALISM_SEED_PREFIX",
        "WCDRAFT_REALISM_GATE",
        "WCDRAFT_CANARY_REGEN",
        "WCDRAFT_LEADERBOARD_BENCH",
        "LEADERBOARD_ENABLED",
        "AUTH_COOKIE_SECRET",
        "WCDRAFT_OG_SIGNING_SECRET",
        "WCDRAFT_CSP_REPORT_ONLY",
        "DATABASE_URL",
        "RESEND_API_KEY",
        "AUTH_EMAIL_FROM",
        "AUTH_BASE_URL",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_URL",
        "VERCEL_DEPLOYMENT_ID",
        "WCDRAFT_DEPLOY_REVISION",
        "WCDRAFT_SITE_URL",
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "test:realism:heavy": {
      "dependsOn": ["^build"],
      "env": [
        "WCDRAFT_REALISM_HEAVY",
        "WCDRAFT_REALISM_N",
        "WCDRAFT_REALISM_SEED_PREFIX",
        "WCDRAFT_REALISM_GATE"
      ]
    },
    "test:golden": {},
    "test:golden:draft": {},
    "test:golden:data": {
      "dependsOn": ["^build"]
    },
    "test:golden:integration": {
      "dependsOn": ["^build"]
    },
    "test:golden:leaderboard": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL_UNPOOLED", "DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL_UNPOOLED"]
    },
    "db:migrate:status": {
      "cache": false,
      "env": ["DATABASE_URL_UNPOOLED"]
    },
    "db:rollback-check": {
      "cache": false,
      "env": [
        "DATABASE_URL_UNPOOLED",
        "NEON_API_KEY",
        "NEON_PROJECT_ID",
        "NEON_EPHEMERAL_BRANCH_ID"
      ]
    },
    "db:branch:create": {
      "cache": false,
      "env": ["NEON_API_KEY", "NEON_PROJECT_ID", "GITHUB_RUN_ID", "GITHUB_OUTPUT"]
    },
    "db:branch:delete": {
      "cache": false,
      "env": ["NEON_API_KEY", "NEON_PROJECT_ID", "NEON_EPHEMERAL_BRANCH_ID"]
    }
  }
}
