# wcdraft — local env template. Copy to `.env.local` (gitignored) and paste
# real values. NEVER commit a populated copy. NEVER paste these values into
# CI logs, screenshots, or chat.
#
# `.gitignore` excludes `.env` and `.env.*` but allows `.env.example` so this
# template stays committed as a sign-post.

# ─── Phase F (F-1) — Neon Postgres ───────────────────────────────────────────
#
# AT REST (committed): only the SECRETS for branch provisioning live in your
# local shell env or in CI repo secrets:
#
#   NEON_API_KEY    — personal/CI Neon API key. Used by
#                     `scripts/neon-branch-create.ts` to fork an EPHEMERAL
#                     branch off the project's primary and delete it after.
#                     CI sets this as a repo secret.
#
#   NEON_PROJECT_ID — id of the Neon project. CI sets this as a repo secret
#                     so it doesn't have to list projects on each run.
#
# AT RUNTIME (auto-generated, gitignored): `db:branch:create` writes both
# of these to a working env file so migrate + rollback-check find them:
#
#   DATABASE_URL          → POOLED  (host: ...-pooler.neon.tech)
#                           Runtime route handlers in F-2/F-3/F-4 will use
#                           this via `getDb()`. Pooling prevents the
#                           serverless-function concurrency spike from
#                           blowing past Postgres' connection cap.
#
#   DATABASE_URL_UNPOOLED → DIRECT (host: ...neon.tech, no `-pooler`)
#                           Used by CLI migrations
#                           (`pnpm --filter @wcdraft/db db:migrate` /
#                           `db:rollback-check`). Pooled URLs reject the
#                           CREATE/ALTER-in-transaction pattern drizzle-orm's
#                           migrator uses.
#
#   NEON_EPHEMERAL_BRANCH_ID → the ephemeral branch's id. Passed to
#                           rollback-check.ts as the SENTINEL that proves
#                           the destructive run is targeting a disposable
#                           branch, not production.
#
# Local "I just want to run a quick rollback-check" recipe:
#
#   # 1. Put NEON_API_KEY + NEON_PROJECT_ID in ~/.config/wcdraft/neon.env
#   #    (mode 0600). Source them:
#   set -a; . ~/.config/wcdraft/neon.env; set +a
#
#   # 2. Provision an ephemeral branch + write its env file.
#   pnpm --filter @wcdraft/db db:branch:create .env.local
#
#   # 3. Run the round-trip.
#   set -a; . .env.local; set +a
#   pnpm --filter @wcdraft/db db:migrate
#   pnpm --filter @wcdraft/db db:rollback-check
#
#   # 4. Tear down.
#   pnpm --filter @wcdraft/db db:branch:delete

NEON_API_KEY=
NEON_PROJECT_ID=

# Build/runtime env names mirrored from turbo.json. Values belong in local
# gitignored env files or deployment secrets, never in this template.
LEADERBOARD_ENABLED=
DATABASE_URL=
AUTH_COOKIE_SECRET=
VERCEL_GIT_COMMIT_SHA=
VERCEL_URL=
VERCEL_DEPLOYMENT_ID=
WCDRAFT_DEPLOY_REVISION=
WCDRAFT_SITE_URL=
NEXT_PUBLIC_SITE_URL=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_BASE_URL=
WCDRAFT_CSP_REPORT_ONLY=

# Per-run OpenGraph share-image signing. Server-only HMAC secret used by
# /api/og/sign and /api/og/run so social cards can render only server-verified
# run models. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WCDRAFT_OG_SIGNING_SECRET=
