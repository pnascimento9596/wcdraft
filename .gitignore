# Dependencies
node_modules/

# Build output
dist/
.next/
out/
.turbo/
*.tsbuildinfo

# Mirrored runtime data — copied from packages/data/src/generated/ at
# build time by `packages/data/scripts/copy-web-assets.mjs`. The source
# of truth is regenerated from tracked ETL/runtime fingerprints.
apps/web/public/data/

# Oversized deterministic generated artifacts. These are intentionally kept out
# of normal git and regenerated by packages/data/scripts/ensure-generated-artifacts.mjs.
etl/output/ratings.json
packages/data/src/generated/draft-pool.compact.json

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Python (etl)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Build-generated service-worker version anchor. Written by
# `apps/web/scripts/generate-sw-version.mjs` from the copied data
# manifest + a per-deploy revision. Source of truth is the generator;
# checking this in would defeat the per-deploy cache-bust contract.
apps/web/public/sw-version.js

# --- Local-checkout hygiene (agent scratch + review captures) ---
# Vercel CLI project link. Holds only project.json (projectId/orgId/projectName)
# + README.txt — no secrets — but it is machine-local and never belongs in git.
.vercel/

# Browser-automation scratch dirs (Playwright CLI / MCP run artifacts).
.playwright-cli/
.playwright-mcp/

# Prompt / marketing export scratch dropped by agent runs.
prompt-exports/

# Agent scratch from local rating/debug passes. Keep committed CSVs under
# docs/, etl/output/, etl/overrides/, and etl/merit/ trackable.
/_rating_delta_run*/
/*.csv
.claude/

# Loose verification screenshots captured at the repo ROOT during review
# passes. Leading slash anchors this to the top level only, so committed
# brand/marketing icons (apps/web/public/**) and review captures under
# docs/screenshots/** stay tracked. Keep durable shots under docs/, not here.
/*.png
