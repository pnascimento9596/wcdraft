{
  "name": "wcdraft",
  "version": "0.0.0",
  "private": true,
  "description": "World Cup draft simulator monorepo.",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "check:agent-contracts": "node scripts/check-agent-contracts.mjs",
    "check:generated": "node packages/data/scripts/ensure-generated-artifacts.mjs --check",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:golden:integration": "turbo run test:golden:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mobile:sync": "pnpm --filter @wcdraft/mobile sync",
    "mobile:build": "pnpm --filter @wcdraft/mobile build",
    "mobile:open": "pnpm --filter @wcdraft/mobile open"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "3.8.5",
    "tsx": "^4.23.12",
    "turbo": "^2.10.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
