{
  "name": "@wcdraft/data",
  "version": "0.0.0",
  "private": true,
  "description": "Curated wcdraft runtime datasets and access helpers. Compact bundles built deterministically from the ETL output, distributed under CC-BY-SA 4.0 with full source attribution. See README for the attribution obligation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src/generated"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:golden": "vitest run test/compact-data.golden.test.ts",
    "test:golden:data": "vitest run test/compact-data.golden.test.ts test/compact-data.integrity.test.ts",
    "test:golden:integration": "vitest run test/e2e-real-run.golden.test.ts test/era-presets.golden.test.ts",
    "test:realism:heavy": "WCDRAFT_REALISM_HEAVY=1 vitest run test/realism/realism.gate.test.ts",
    "build:compact": "node scripts/build-compact-data.mjs",
    "copy:web-assets": "node scripts/copy-web-assets.mjs",
    "gen:e2e-golden": "tsx scripts/generate-e2e-golden.mjs",
    "gen:era-golden": "tsx scripts/generate-era-golden.mts"
  },
  "dependencies": {
    "@wcdraft/core": "workspace:*"
  }
}
