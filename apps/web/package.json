{
  "name": "@wcdraft/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "runtime:materialize": "node ../../packages/data/scripts/copy-web-assets.mjs",
    "predev": "pnpm run runtime:materialize && node scripts/generate-icons.mjs && node scripts/generate-marketing-assets.mjs && node scripts/generate-sw-version.mjs",
    "dev": "next dev",
    "prebuild": "pnpm run runtime:materialize && node scripts/generate-icons.mjs && node scripts/generate-marketing-assets.mjs && node scripts/generate-sw-version.mjs",
    "build": "next build --webpack && node scripts/verify-runtime-data-traces.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "pnpm run runtime:materialize",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run runtime:materialize && node scripts/generate-sw-version.mjs",
    "test:unit": "vitest run --exclude 'lib/game/__tests__/responsive-layout-browser.contract.test.ts'",
    "test:browser": "vitest run lib/game/__tests__/responsive-layout-browser.contract.test.ts && tsx scripts/game-flow-playwright.mts && tsx scripts/test-responsive-shell-fit.mts && tsx scripts/verify-home-fold-browser.mts",
    "test": "pnpm run test:unit && pnpm run test:browser",
    "benchmark:runtime-data-browser": "tsx scripts/benchmark-runtime-data-browser.mts",
    "test:golden:leaderboard": "pnpm run runtime:materialize && vitest run lib/leaderboard/__tests__/validate.golden.test.ts",
    "gen:leaderboard-golden": "tsx scripts/generate-leaderboard-golden.mts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:marketing-assets": "node scripts/generate-marketing-assets.mjs",
    "generate:sw-version": "node scripts/generate-sw-version.mjs",
    "gen:token-skew": "tsx scripts/generate-token-skew-fixtures.mts",
    "report:club-crests": "tsx scripts/generate-club-crest-coverage.mts",
    "verify:club-crests-browser": "tsx scripts/verify-club-crests-browser.mts",
    "verify:open-draft-browser": "tsx scripts/verify-open-draft-browser-proof.mts",
    "test:responsive:shell": "tsx scripts/test-responsive-shell-fit.mts",
    "verify:narrow-collisions": "WCDRAFT_COLLISION_GATE_ONLY=1 tsx scripts/test-responsive-shell-fit.mts",
    "verify:narrow-collision-controls": "WCDRAFT_COLLISION_CONTROLS_ONLY=1 tsx scripts/test-responsive-shell-fit.mts",
    "create:disposable-clone": "tsx scripts/create-disposable-clone.mts",
    "mark:agent-temp-cleanup-ready": "tsx scripts/mark-agent-temp-cleanup-ready.mts",
    "verify:responsive-layout": "tsx scripts/verify-responsive-layout-browser.mts",
    "preverify:home-fold": "pnpm run runtime:materialize",
    "verify:home-fold": "tsx scripts/verify-home-fold-browser.mts",
    "preverify:one-screen": "pnpm run runtime:materialize",
    "verify:one-screen": "tsx scripts/verify-home-fold-browser.mts",
    "preverify:native-app-feel": "pnpm exec turbo run build --filter=@wcdraft/web^...",
    "verify:native-app-feel": "tsx scripts/verify-native-app-feel-browser.mts",
    "preverify:native-app-feel:webkit": "pnpm exec turbo run build --filter=@wcdraft/web",
    "verify:native-app-feel:webkit": "WCDRAFT_NATIVE_APP_FEEL_SERVER=production tsx scripts/verify-native-app-feel-webkit.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@wcdraft/core": "workspace:*",
    "@wcdraft/data": "workspace:*",
    "@wcdraft/db": "workspace:*",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^20.11.2",
    "playwright-core": "^1.62.1",
    "vitest": "^4.1.10"
  }
}
