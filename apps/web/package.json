{
  "name": "@wcdraft/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../packages/data/scripts/copy-web-assets.mjs && node scripts/generate-icons.mjs",
    "dev": "next dev",
    "prebuild": "node ../../packages/data/scripts/copy-web-assets.mjs && node scripts/generate-icons.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "node ../../packages/data/scripts/copy-web-assets.mjs",
    "typecheck": "tsc --noEmit",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@wcdraft/core": "workspace:*",
    "@wcdraft/data": "workspace:*",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3"
  }
}
