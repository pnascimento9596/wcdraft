{
  "name": "@wcdraft/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../packages/data/scripts/copy-web-assets.mjs && node scripts/generate-icons.mjs && node scripts/generate-marketing-assets.mjs && node scripts/generate-sw-version.mjs",
    "dev": "next dev",
    "prebuild": "node ../../packages/data/scripts/copy-web-assets.mjs && node scripts/generate-icons.mjs && node scripts/generate-marketing-assets.mjs && node scripts/generate-sw-version.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "node ../../packages/data/scripts/copy-web-assets.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node ../../packages/data/scripts/copy-web-assets.mjs && node scripts/generate-sw-version.mjs",
    "test": "vitest run && tsx scripts/game-flow-playwright.mts && tsx scripts/test-responsive-shell-fit.mts",
    "test:golden:leaderboard": "node ../../packages/data/scripts/copy-web-assets.mjs && vitest run lib/leaderboard/__tests__/validate.golden.test.ts",
    "gen:leaderboard-golden": "tsx scripts/generate-leaderboard-golden.mts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:marketing-assets": "node scripts/generate-marketing-assets.mjs",
    "generate:sw-version": "node scripts/generate-sw-version.mjs",
    "gen:token-skew": "tsx scripts/generate-token-skew-fixtures.mts",
    "report:club-crests": "tsx scripts/generate-club-crest-coverage.mts",
    "verify:club-crests-browser": "tsx scripts/verify-club-crests-browser.mts",
    "verify:open-draft-browser": "tsx scripts/verify-open-draft-browser-proof.mts",
    "test:responsive:shell": "tsx scripts/test-responsive-shell-fit.mts",
    "verify:responsive-layout": "tsx scripts/verify-responsive-layout-browser.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@wcdraft/core": "workspace:*",
    "@wcdraft/data": "workspace:*",
    "@wcdraft/db": "workspace:*",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-orm": "^0.45.2",
    "playwright-core": "^1.61.1",
    "vitest": "^4.1.10"
  }
}
