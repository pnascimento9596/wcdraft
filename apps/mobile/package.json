{
  "name": "@wcdraft/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Capacitor iOS native wrapper for the wcdraft PWA (M1a scaffold).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'no lint targets in @wcdraft/mobile yet'",
    "test": "node --test scripts/config.test.mjs scripts/assets.test.mjs",
    "build": "node scripts/prepare-www.mjs",
    "sync": "node scripts/prepare-www.mjs && node scripts/generate-ios-assets.mjs && npx cap sync ios",
    "open": "npx cap open ios",
    "cap:sync": "npx cap sync ios",
    "cap:open": "npx cap open ios",
    "generate:assets": "node scripts/generate-ios-assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "typescript": "~6.0.3"
  }
}
