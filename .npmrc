# Brand-new tool majors are pinned via the lockfile; keep peer resolution
# permissive so installs are not blocked by transitive peer-range churn.
strict-peer-dependencies=false
# Hoist nothing implicitly beyond pnpm defaults; determinism comes from the lockfile.

# Dependabot injects GitHub Packages credentials for private repositories; keep
# public npm dependency resolution anchored to npmjs so scoped public packages do
# not resolve against stale GitHub Packages metadata.
registry=https://registry.npmjs.org/
@types:registry=https://registry.npmjs.org/
